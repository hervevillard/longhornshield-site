{
  // Cloudflare configuration for longhornshield.org
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longhornshield",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serves public/404.html for unknown URLs.
    "not_found_handling": "404-page",
    // Static files are served straight from the edge; only /api/* touches the Worker.
    "run_worker_first": ["/api/*"],
  },

  // Plain text values. Safe to commit — nothing secret here.
  "vars": {
    "NOTIFY_TO": "quotes@longhornshield.org",
    "NOTIFY_FROM": "website@longhornshield.org",
  },

  "observability": { "enabled": true },

  // ---- Optional extras, uncomment when you set them up ----
  //
  // Cloudflare Email Sending (requires the $5/month Workers Paid plan):
  // "send_email": [{ "name": "EMAIL" }],
  //
  // Keep a backup copy of every submission. Create it first with:
  //   npx wrangler kv namespace create LEADS
  // then paste the returned id below.
  // "kv_namespaces": [{ "binding": "LEADS", "id": "PASTE_KV_NAMESPACE_ID" }]

}
